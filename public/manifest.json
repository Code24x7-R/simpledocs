{
  "name": "SimpleDocs",
  "short_name": "SimpleDocs",
  "description": "Browser-based Word-compatible document editor. Fully client-side.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAF7F2",
  "theme_color": "#1A1A2E",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [".sdjson"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_queue": {}
}
